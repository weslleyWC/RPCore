<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RPCore</AssemblyName>
    <RootNamespace>RPCore</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\scripts\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ReferenceDir Condition="'$(ReferenceDir)'=='' And Exists('$(MSBuildProjectDirectory)/.deps/ScriptHookVDotNet3.dll')">$(MSBuildProjectDirectory)/.deps</ReferenceDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;assets/**;dist/**</DefaultItemExcludes>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- FILL: your GTA V root, or pass /p:GTAV="D:\Games\GTAV" -->
    <GTAV Condition="'$(GTAV)'==''">C:\Program Files\Rockstar Games\Grand Theft Auto V</GTAV>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="config/Jobs/PdmLogistics.json" LogicalName="RPCore.JobDefaults.PdmLogistics.json" />
    <EmbeddedResource Include="config/Jobs/Pdm.json" LogicalName="RPCore.JobDefaults.Pdm.json" />
    <EmbeddedResource Include="config/Jobs/Drag.json" LogicalName="RPCore.JobDefaults.Drag.json" />
    <EmbeddedResource Include="config/Jobs/Streamer.json" LogicalName="RPCore.JobDefaults.Streamer.json" />
    <EmbeddedResource Include="config/Jobs/Dealer.json" LogicalName="RPCore.JobDefaults.Dealer.json" />
    <EmbeddedResource Include="config/Jobs/Crafting.json" LogicalName="RPCore.JobDefaults.Crafting.json" />
    <EmbeddedResource Include="config/Jobs/Fishing.json" LogicalName="RPCore.JobDefaults.Fishing.json" />
    <EmbeddedResource Include="config/Jobs/Hunting.json" LogicalName="RPCore.JobDefaults.Hunting.json" />
    <EmbeddedResource Include="config/Jobs/Pilot.json" LogicalName="RPCore.JobDefaults.Pilot.json" />
    <EmbeddedResource Include="config/Jobs/PrisonTransport.json" LogicalName="RPCore.JobDefaults.PrisonTransport.json" />
    <EmbeddedResource Include="config/Jobs/FuelDelivery.json" LogicalName="RPCore.JobDefaults.FuelDelivery.json" />
    <EmbeddedResource Include="config/Jobs/StoreDelivery.json" LogicalName="RPCore.JobDefaults.StoreDelivery.json" />
    <EmbeddedResource Include="config/Jobs/PostOp.json" LogicalName="RPCore.JobDefaults.PostOp.json" />
    <EmbeddedResource Include="config/Jobs/Uber.json" LogicalName="RPCore.JobDefaults.Uber.json" />
    <EmbeddedResource Include="config/Jobs/Valet.json" LogicalName="RPCore.JobDefaults.Valet.json" />
    <EmbeddedResource Include="config/Visuals/Catalog.json" LogicalName="RPCore.VisualDefaults.Catalog.json" />
    <EmbeddedResource Include="config/Visuals/Bindings.json" LogicalName="RPCore.VisualDefaults.Bindings.json" />
    <Reference Include="ScriptHookVDotNet3">
      <HintPath Condition="'$(ReferenceDir)'!=''">$(ReferenceDir)/ScriptHookVDotNet3.dll</HintPath>
      <HintPath Condition="'$(ReferenceDir)'==''">$(GTAV)\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath Condition="'$(ReferenceDir)'!=''">$(ReferenceDir)/LemonUI.SHVDN3.dll</HintPath>
      <HintPath Condition="'$(ReferenceDir)'==''">$(GTAV)\scripts\LemonUI.SHVDN3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
